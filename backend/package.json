{
  "name": "training-dashboard-api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute training-dashboard --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute training-dashboard --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
